+### **5. Servicios de Auditor├¡a (Business Logic)**
+
+**Ubicaci├│n:** `backend/app/services/audit.py` (NUEVO)
+
+```python
+"""Audit service for logging lead changes"""
+
+import logging
+from typing import Optional, Any, Dict
+from datetime import datetime, timezone
+
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.models.audit import LeadAuditLog, AuditEventType
+from app.models.lead import Lead
+
+logger = logging.getLogger(__name__)
+
+
+class AuditService:
+    """Service for creating audit log entries"""
+    
+    @staticmethod
+    async def log_lead_created(
+        db: AsyncSession,
+        lead: Lead,
+        created_by: str = "system",
+    ) -> LeadAuditLog:
+        """Log when a lead is created"""
+        audit_entry = LeadAuditLog(
+            lead_id=lead.id,
+            event_type=AuditEventType.CREATED.value,
+            old_value=None,
+            new_value={
+                "id": lead.id,
+                "name": lead.name,
+                "company": lead.company,
+                "email": lead.email,
+                "status": lead.status,
+            },
+            description=f"Lead creado: {lead.name}",
+            created_by=created_by,
+            created_at=datetime.now(timezone.utc),
+        )
+        db.add(audit_entry)
+        await db.flush()  # Ensure it's saved
+        return audit_entry
+    
+    @staticmethod
+    async def log_field_edited(
+        db: AsyncSession,
+        lead_id: int,
+        field_name: str,
+        old_value: Any,
+        new_value: Any,
+        created_by: str = "system",
+    ) -> LeadAuditLog:
+        """Log when a field is edited"""
+        audit_entry = LeadAuditLog(
+            lead_id=lead_id,
+            event_type=AuditEventType.FIELD_EDITED.value,
+            old_value=old_value if isinstance(old_value, dict) else {"value": str(old_value)},
+            new_value=new_value if isinstance(new_value, dict) else {"value": str(new_value)},
+            field_name=field_name,
+            description=f"Campo editado: {field_name}",
+            created_by=created_by,
+            created_at=datetime.now(timezone.utc),
+        )
+        db.add(audit_entry)
+        await db.flush()
+        return audit_entry
+    
+    @staticmethod
+    async def log_status_changed(
+        db: AsyncSession,
+        lead_id: int,
+        old_status: str,
+        new_status: str,
+        created_by: str = "system",
+    ) -> LeadAuditLog:
+        """Log when status changes"""
+        audit_entry = LeadAuditLog(
+            lead_id=lead_id,
+            event_type=AuditEventType.STATUS_CHANGED.value,
+            old_value=old_status,
+            new_value=new_status,
+            field_name="status",
+            description=f"Status cambio de '{old_status}' a '{new_status}'",
+            created_by=created_by,
+            created_at=datetime.now(timezone.utc),
+        )
+        db.add(audit_entry)
+        await db.flush()
+        return audit_entry
+    
+    @staticmethod
+    async def log_lead_deleted(
+        db: AsyncSession,
+        lead_id: int,
+        lead_name: str,
+        created_by: str = "system",
+    ) -> LeadAuditLog:
+        """Log when a lead is deleted"""
+        audit_entry = LeadAuditLog(
+            lead_id=lead_id,
+            event_type=AuditEventType.DELETED.value,
+            old_value={"name": lead_name},
+            new_value=None,
+            description=f"Lead eliminado: {lead_name}",
+            created_by=created_by,
+            created_at=datetime.now(timezone.utc),
+        )
+        db.add(audit_entry)
+        await db.flush()
+        return audit_entry
+```
