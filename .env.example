# ===================================================================
# Mini CRM Environment Configuration Example
# Copy this file to .env and update values for your environment
# ===================================================================

# DATABASE CONFIGURATION
# ===================================================================
# PostgreSQL connection details
# In development: use "postgres" as host (service name in docker-compose)
# In production: use actual postgres hostname/IP
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=minicrmdb

# APPLICATION CONFIGURATION
# ===================================================================
# ENVIRONMENT: development | staging | production
# Controls logging verbosity, uvicorn --reload, etc.
ENVIRONMENT=development

# DEBUG: True | False
# Enables verbose logging and error details (disable in production!)
DEBUG=True

# CORS CONFIGURATION
# ===================================================================
# Comma-separated list of allowed origins for CORS
# Development: Allow localhost frontend
# Production: Use actual domain (e.g., https://crm.example.com)
CORS_ORIGINS=http://localhost:3000

# ===================================================================
# 🔐 IMPORTANT NOTES
# ===================================================================
# 1. NEVER commit .env file to git (should be in .gitignore)
# 2. THIS file (.env.example) IS committed and serves as documentation
# 3. Development credentials above are safe to expose (demo values only)
# 4. For production:
#    - Use strong DB_PASSWORD
#    - Use HTTPS endpoints for CORS_ORIGINS
#    - Set ENVIRONMENT=production (disables hot-reload)
#    - Set DEBUG=False (reduces logging overhead)
#
# ===================================================================
